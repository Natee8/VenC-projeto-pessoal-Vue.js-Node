{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,

    "baseUrl": ".",

    "types": ["vite/client"],
    "ignoreDeprecations": "6.0"
  },

  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],

  "exclude": ["node_modules", "dist"]
}
