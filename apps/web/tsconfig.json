{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,

    "baseUrl": ".",

    "types": ["vite/client", "node"],

    "paths": {
      "@packages": ["../../packages/src/index.ts"],
      "@packages/*": ["../../packages/src/*"]
    }
  },

  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
