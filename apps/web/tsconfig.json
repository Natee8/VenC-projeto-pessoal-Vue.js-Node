{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "target": "esnext",

    "module": "ESNext",

    "moduleResolution": "Bundler",

    "strict": true,

    "esModuleInterop": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"],

      "@repositories/*": ["src/infrastructure/repositories/*"],

      "@packages/*": ["../../packages/src/*"]
    },

    "types": ["vite/client"],

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "../../packages/src/**/*.ts"
  ],

  "exclude": ["node_modules", "dist"]
}
