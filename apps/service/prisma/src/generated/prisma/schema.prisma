enum State {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

model Address {
  id           Int    @id @default(autoincrement())
  street       String
  number       String
  neighborhood String
  city         String
  state        State
  zipCode      String

  latitude  Float?
  longitude Float?

  complement String?

  ownerProfileId Int? @unique
  caregiverId    Int? @unique

  ownerProfile OwnerProfile? @relation(fields: [ownerProfileId], references: [id])
  caregiver    Caregiver?    @relation(fields: [caregiverId], references: [id])
}

model Caregiver {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  offersHosting   Boolean
  serviceRadiusKm Float
  isVerified      Boolean  @default(false)
  isPublicProfile Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  address Address?

  user     UserAuth       @relation(fields: [userId], references: [id])
  services ServiceOffer[]

  @@index([isPublicProfile, isActive])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

model OwnerProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  searchRadiusKm Float?

  phone String?

  address Address?

  user UserAuth @relation(fields: [userId], references: [id])
}

model Review {
  id             Int           @id @default(autoincrement())
  serviceOfferId Int?
  serviceOffer   ServiceOffer? @relation(fields: [serviceOfferId], references: [id])
  reviewerUserId Int
  reviewer       UserAuth      @relation("Reviewer", fields: [reviewerUserId], references: [id])
  targetUserId   Int
  targetUser     UserAuth      @relation("Target", fields: [targetUserId], references: [id])
  rating         Int
  comment        String?
  createdAt      DateTime      @default(now())

  @@unique([reviewerUserId, targetUserId, serviceOfferId])
  @@index([targetUserId, createdAt])
  @@index([reviewerUserId])
}

model ServiceOffer {
  id          Int      @id @default(autoincrement())
  caregiverId Int
  type        String
  description String
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
  reviews   Review[]
}

model UserAuth {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  passwordHash    String
  isActive        Boolean  @default(true)
  profilePhotoUrl String?
  birthDate       DateTime
  cpf             String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownerProfile  OwnerProfile?
  caregiver     Caregiver?
  refreshTokens RefreshToken[]

  reviewsGiven    Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Target")
}

model RefreshToken {
  token     String   @id
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user UserAuth @relation(fields: [userId], references: [id], onDelete: Cascade)
}
