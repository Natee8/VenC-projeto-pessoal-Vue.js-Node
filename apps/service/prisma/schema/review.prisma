

model UserReview {
  id             Int      @id @default(autoincrement())
  reviewerUserId Int
  targetUserId   Int
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  reviewer UserAuth @relation("Reviewer", fields: [reviewerUserId], references: [id])
  target   UserAuth @relation("Target", fields: [targetUserId], references: [id])

  @@unique([reviewerUserId, targetUserId])
}