enum ReviewTargetRole {
  OWNER
  CAREGIVER
}

model Review {
  id                Int      @id @default(autoincrement())
  serviceOfferId    Int?
  reviewerUserId    Int
  targetUserId      Int
  rating            Int
  comment           String?
  createdAt         DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([reviewerUserId])
  @@unique([reviewerUserId, targetUserId, serviceOfferId])
}