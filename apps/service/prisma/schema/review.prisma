

model ServiceReview {
  id             Int      @id @default(autoincrement())
  serviceOfferId Int
  reviewerUserId Int
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  serviceOffer ServiceOffer @relation(fields: [serviceOfferId], references: [id])

  @@unique([reviewerUserId, serviceOfferId])
  reviewer UserAuth @relation(fields: [reviewerUserId], references: [id])
}

model UserReview {
  id             Int      @id @default(autoincrement())
  reviewerUserId Int
  targetUserId   Int
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  reviewer UserAuth @relation("Reviewer", fields: [reviewerUserId], references: [id])
  target   UserAuth @relation("Target", fields: [targetUserId], references: [id])

  @@unique([reviewerUserId, targetUserId])
}