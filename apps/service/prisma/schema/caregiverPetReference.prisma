enum PetSize {
  SMALL
  MEDIUM
  LARGE
}


model CaregiverPetPreference {
  id          Int      @id @default(autoincrement())
  caregiverId Int
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  animalType  String
  category    String

  minSize PetSize?
  maxSize PetSize?

  accepted    Boolean

  notes       String?
}