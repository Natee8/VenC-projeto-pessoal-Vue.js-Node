{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@values/*": ["packages/values-objects/src/*"]
    }
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/service/src/**/*.ts",
    "packages/values-objects/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
