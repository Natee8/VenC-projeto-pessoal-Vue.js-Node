{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["./packages/src/*"]
    },

    "ignoreDeprecations": "6.0"
  },

  "include": ["apps/**/src/**/*.ts", "packages/**/src/**/*.ts"],

  "exclude": ["node_modules", "dist"]
}
